# Server Port (Default: 3001)
PORT=3001
NODE_ENV=development

# Firebase Project Configuration (Auth & Firestore)
FIREBASE_PROJECT_ID=studio-master-production
FIREBASE_API_KEY=AIzaSyB_vjq-m_QYOwBJ0zx5kdggcpjvgPhai4I
FIREBASE_AUTH_DOMAIN=studio-master-production.firebaseapp.com
FIREBASE_STORAGE_BUCKET=studio-master-production.firebasestorage.app
FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-studiomanager-b326f769-70e0-4eb7-88b9-feba4d05358d

# Razorpay Payment Gateway Credentials (TEST MODE: rzp_test_...)
# Get these from https://dashboard.razorpay.com/app/keys
