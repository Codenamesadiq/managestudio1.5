{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/storage/:match*",
      "destination": "https://studio-manager-saas.onrender.com/storage/:match*"
    },
    {
      "source": "/((?!api/|storage/|assets/|favicon\\.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
